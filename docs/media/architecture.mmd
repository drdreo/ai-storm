flowchart TB
  subgraph browser["BROWSER APPLICATION · React 19 · Vite · Zustand · tldraw · xterm.js · Tailwind v4"]
    direction LR
    sidebar["<b>Sidebar / projects</b><br/>registry projection<br/>folders + ordering<br/>live session status"]:::browserNode
    canvas["<b>Canvas pane · tldraw</b><br/>backend-loaded board snapshots<br/>idea cards + typed arrows<br/>arrange, filter, search, export"]:::browserNode
    hub["<b>Control hub · xterm.js</b><br/>raw PTY bytes rendered faithfully<br/>prompts, resize, session controls<br/>MCP / marker results appear as cards"]:::browserNode
    sidebar ~~~ canvas ~~~ hub
  end

  transport(["<b>/pty WebSocket</b><br/>project-keyed JSON · state requests/responses"]):::transport

  subgraph daemon["LOCAL NODE DAEMON · Hono · 127.0.0.1 · local-only execution"]
    direction LR
    state["<b>BACKEND-OWNED DURABLE STATE</b><br/>StateStore · atomic JSON files<br/>registry.json<br/>projects/&lt;id&gt;/board.json<br/>projects/&lt;id&gt;/history.json<br/>revisioned saves · ref allocation"]:::daemonNode
    runtime["<b>SESSION RUNTIME</b><br/>POSIX: named tmux + pipe-pane<br/>Windows: node-pty / ConPTY<br/>reconcile + idempotent attach<br/>IdeaScanner / ScoreScanner<br/>raw data → xterm · markers → cards"]:::daemonNode
    mcp["<b>MCP CAPTURE</b><br/>POST /mcp/:projectId/:token<br/>capture_idea · capture_score<br/>mark / link · board discovery<br/>StateStore reads · ref allocation<br/>session sinks → /pty WS callbacks"]:::daemonNode
    state ~~~ runtime ~~~ mcp
  end

  canvas --> transport
  transport --> |state API| state
  transport --> |PTY data + input| runtime
  transport --> |idea / score / refs| mcp
  runtime --> |tool calls + sinks| mcp
  state --> |board reads · ref allocation| mcp

